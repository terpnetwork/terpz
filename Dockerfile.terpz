# Lean ICT image: binary is terpz (not terpd). Tag: terpnetwork/terp-core:terpz-lean
FROM alpine:3.20
RUN apk add --no-cache ca-certificates libgcc libstdc++ libc6-compat
COPY build/terpz /usr/local/bin/terpz
# Some ICT helpers still exec $BIN; keep a second name only inside this image.
RUN ln -sf /usr/local/bin/terpz /usr/local/bin/terpd
EXPOSE 1317 26656 26657 9090
ENTRYPOINT ["/usr/local/bin/terpz"]
